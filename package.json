{
  "name": "jevguard",
  "version": "0.1.0",
  "description": "Runtime guardrails for long-running AI agents",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "tsc -p tsconfig.run.json && node .run/examples/research-agent/index.js",
    "eval:calibrate": "tsc -p tsconfig.run.json && node .run/scripts/calibrate.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "private": true
}
